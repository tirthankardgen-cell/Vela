# Real accounts are the default. Use demo explicitly only for local preview tests.
NEXT_PUBLIC_AUTH_MODE=firebase

# Enable Email/Password and Google in Firebase Auth, create Firestore and deploy rules.
# Firebase web app config. These identify the public web app; never use service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Development emulator only; ignored by production builds.
NEXT_PUBLIC_FIREBASE_EMULATORS=false

# Optional measurement ID for the separate public-page analytics integration.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
