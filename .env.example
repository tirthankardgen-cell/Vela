# Real accounts are the default. Use demo explicitly only for local preview tests.
NEXT_PUBLIC_AUTH_MODE=firebase

# Enable Email/Password and Google in Firebase Auth, create Firestore and deploy rules.
# Firebase web app config. These identify the public web app; never use service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Development emulator only; ignored by production builds. Never use real project IDs with emulators.
NEXT_PUBLIC_FIREBASE_EMULATORS=false

# Search Console is already verified. Optional alternative HTML-tag verification:
# Set the content value only, not the entire meta tag.
GOOGLE_SITE_VERIFICATION=

# AdSense publisher ca-pub-6693217545827146 is set in src/lib/site.js.
# Enable after site approval, Auto ads setup, and the required Google privacy messages.
# Remains off by default while account setup/review is pending.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# Optional GA4 analytics. Leave empty to avoid loading Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
