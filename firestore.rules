rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId}/projects/{projectId} {
   function owner() { return request.auth != null && request.auth.uid == userId; }
   allow read, delete: if owner();
   allow create, update: if owner()
    && request.resource.data.keys().hasOnly(['name', 'layout', 'createdAt', 'updatedAt'])
    && request.resource.data.name is string
    && request.resource.data.name.size() <= 100
    && request.resource.data.layout is map
    && request.resource.data.layout.project.id == projectId
    && request.resource.data.updatedAt == request.time;
  }
 }
}
